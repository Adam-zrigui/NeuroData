# Local development database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=methodfinder
DB_USER=postgres
DB_PASSWORD=postgres

# OpenNeuro's public metadata API
OPENNEURO_ENDPOINT=https://openneuro.org/crn/graphql
OPENNEURO_CACHE_DIR=.cache/openneuro
OPENNEURO_REQUEST_DELAY=0.5
# Optional limit for development harvests. Omit or set to 0 for all available datasets.
OPENNEURO_LIMIT=0

# Optional hosted model access. Without a key, rule parsing is used and unresolved fields stay unknown.
OPENROUTER_API_KEY=
QUERY_MODEL=google/gemma-4-26b-a4b-it:free
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_REQUEST_DELAY=1
LLM_EXTRACTION_LIMIT=20

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
